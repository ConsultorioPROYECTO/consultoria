{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    // Optimizaciones para Next.js 15.5 (configuración conservadora)
    // "verbatimModuleSyntax": true, // Comentado para compatibilidad
    "allowImportingTsExtensions": false,
    // "noUncheckedIndexedAccess": true, // Para habilitar gradualmente
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/app/components/*"],
      "@lib/*": ["./src/app/lib/*"],
      "@Types/*": ["./src/app/types/*"],
      "@db/*": ["./src/db/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

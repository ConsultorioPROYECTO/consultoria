{
  "name": "consultoria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NODE_OPTIONS=--max-old-space-size=3072 next build",
    "start": "next start",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:next": "next lint",
    "lint:jsdoc": "eslint --config .eslintrc.jsdoc.js src/app/api/**/*.ts src/lib/**/*.ts",
    "docs:check": "npm run lint:jsdoc",
    "docs:api": "echo 'Documentación de API disponible en docs/api/doctors-availability.md'",
    "generate": "drizzle-kit generate"

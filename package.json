  "jest": {
    "transform": {
      "^.+\\.[t|j]sx?$": [
        "babel-jest",
        {
          "configFile": "./jest.babel.config.js"
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
